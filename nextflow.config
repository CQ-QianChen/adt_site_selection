workDir = '.work'

// Upper limit of CPUs used at the same time (nextflow run ... --max_cpus 48)
params.max_cpus = 4

// Each module declares its conda environment in modules/. With --containerized
// the processes run from the image of their module instead of conda:
//   nextflow run main.nf --config_file scenario/Case3_Claystone.yaml --containerized
// The image of a module is <imageRepo>/<module>:<imageTag>, built from <module>/Dockerfile;
// under conda the container of a process is null, which leaves it unset.
params.containerized = false
params.imageRepo = 'ghcr.io/cq-qianchen/adt_site_selection'
params.imageTag = 'main'

conda.enabled = !params.containerized

// Docker is the default engine. The user id keeps the files in the work folder yours.
docker.enabled = true
docker.runOptions = '-u $(id -u):$(id -g)'

executor.cpus = params.max_cpus
process.resourceLimits = [cpus: params.max_cpus]

process {
    // the module whose image each process runs in (CREATE_DATASTORE only writes a file and has none)
    withName: COMMUNICATION_SDH { container = params.containerized ? "${params.imageRepo}/communication_sdh:${params.imageTag}" : null }
    withName: COMMUNICATION_NTD { container = params.containerized ? "${params.imageRepo}/communication_ntd:${params.imageTag}" : null }
    withName: 'SAMPLING_.*' { container = params.containerized ? "${params.imageRepo}/sampling:${params.imageTag}" : null }
    withName: SURROGATE { container = params.containerized ? "${params.imageRepo}/surrogate:${params.imageTag}" : null }
    withName: 'SENSITIVITY|PROPAGATION' { container = params.containerized ? "${params.imageRepo}/decision_support_uq:${params.imageTag}" : null }
    withName: ANALYSIS { container = params.containerized ? "${params.imageRepo}/decision_support_analysis:${params.imageTag}" : null }
    withName: 'REPORT|COMPARE' { container = params.containerized ? "${params.imageRepo}/decision_support_report:${params.imageTag}" : null }

    // ensemble runs: one OGS worker per CPU
    withName: 'MODEL_.*' {
        cpus = params.max_cpus
        container = params.containerized ? "${params.imageRepo}/model:${params.imageTag}" : null
    }
}

// one thread per worker: more threads only slow OGS and the fits down
env {
    OMP_NUM_THREADS = '1'
    MKL_NUM_THREADS = '1'
    OPENBLAS_NUM_THREADS = '1'
}

profiles {
    // Apptainer instead of Docker, for example on a cluster: it pulls the same images
    apptainer {
        docker.enabled = false
        apptainer.enabled = true
        apptainer.autoMounts = true
    }
}
