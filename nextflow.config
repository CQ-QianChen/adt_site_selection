workDir = '.work'

conda.enabled = true

// Upper limit of CPUs used at the same time (nextflow run ... --max_cpus 48)
params.max_cpus = 4

executor.cpus = params.max_cpus
process.resourceLimits = [cpus: params.max_cpus]

process {
    // ensemble runs: one OGS worker per CPU
    withName: 'MODEL_.*' {
        cpus = params.max_cpus
    }
}

// one thread per worker: more threads only slow OGS and the fits down
env {
    OMP_NUM_THREADS = '1'
    MKL_NUM_THREADS = '1'
    OPENBLAS_NUM_THREADS = '1'
}
